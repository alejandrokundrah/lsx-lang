{
  "name": "lsx-lang",
  "version": "0.2.1",
  "description": "LSX - The Easiest Programming Language",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "lsx": "cli.js"
  },
  "files": [
    "cli.js",
    "index.js",
    "transpiler.js",
    "transpiler.d.ts",
    "lexer.js",
    "parser.js",
    "codegen.js",
    "type-checker.js",
    "bundler.js",
    "dev-server.js",
    "config.js",
    "config.d.ts",
    "packages/lsx-core",
    "SPEC.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node transpiler.js",
    "dev": "node dev-server.js",
    "test": "node test.js && node test-e2e.js",
    "quality": "npm test && npm --prefix vscode-extension run compile && npm --prefix vscode-extension/server run compile",
    "prepublishOnly": "npm run quality"
  },
  "keywords": [
    "programming-language",
    "react",
    "web-development",
    "transpiler"
  ],
  "author": "LSX Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsx-lang/lsx.git"
  },
  "homepage": "https://github.com/lsx-lang/lsx#readme",
  "bugs": {
    "url": "https://github.com/lsx-lang/lsx/issues"
  },
  "dependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-preset-minify": "^0.5.1",
    "chokidar": "^3.5.3",
    "esbuild": "^0.19.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "lsx-core": "file:./packages/lsx-core",
    "@types/node": "^20.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
